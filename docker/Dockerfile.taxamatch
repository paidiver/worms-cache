# taxamatch_rb pins json 1.8, which requires Ruby 2.x. The full build image
# already includes the compiler needed by native gems, avoiding apt installs
# against retired Debian repositories.
FROM ruby:2.7-bullseye AS build
WORKDIR /app
COPY taxamatch_service/Gemfile taxamatch_service/Gemfile.lock /app/
RUN gem install bundler -v 2.4.22 && bundle _2.4.22_ install

FROM ruby:2.7-slim-bullseye
WORKDIR /app
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY taxamatch_service/. /app
ENV RACK_ENV=production
EXPOSE 8080
CMD ["bundle", "exec", "puma", "-C", "puma.rb", "config.ru"]
